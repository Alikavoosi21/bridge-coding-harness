{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "src/lib/harness",
    "outDir": "node_modules/.cache/onboard-harness-tests",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["src/lib/harness/**/*.ts"]
}
