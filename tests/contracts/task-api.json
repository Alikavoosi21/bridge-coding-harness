{
  "schema_version": 5,
  "event_schema_version": 1,
  "endpoints": [
    { "method": "POST", "path": "/tasks", "status": 202 },
    { "method": "GET", "path": "/tasks" },
    { "method": "GET", "path": "/tasks/{task_id}" },
    { "method": "GET", "path": "/tasks/{task_id}/events", "query": { "after_seq": 0, "limit": 500 } },
    { "method": "POST", "path": "/tasks/{task_id}/messages", "status": 200 },
    { "method": "POST", "path": "/tasks/{task_id}/plan-proposals", "status": 202 },
    { "method": "POST", "path": "/tasks/{task_id}/continuations", "status": 202 },
    { "method": "PATCH", "path": "/tasks/{task_id}/plan" },
    { "method": "POST", "path": "/tasks/{task_id}/plan-decisions" },
    { "method": "DELETE", "path": "/tasks/{task_id}", "query": { "consent": false } }
  ],
  "task_request_keys": ["prompt", "workspace_id", "title", "model_id", "mode", "read_only", "limits", "references", "idempotency_key"],
  "task_keys": [
    "id",
    "workspace_id",
    "thread_id",
    "title",
    "prompt",
    "status",
    "outcome",
    "mode",
    "read_only",
    "revision",
    "created_at",
    "updated_at",
    "budget",
    "runs",
    "plan",
    "last_event_seq"
  ],
  "run_keys": ["id", "task_id", "segment", "state", "budget_id", "worker_lease_id", "created_at", "started_at", "ended_at"],
  "budget_keys": [
    "id",
    "task_id",
    "active_ms",
    "model_calls",
    "tool_calls",
    "max_active_ms",
    "max_model_calls",
    "max_tool_calls",
    "revision",
    "updated_at"
  ],
  "action_keys": [
    "operation_id",
    "task_id",
    "invocation_key",
    "origin_run_id",
    "tool_call_id",
    "args_hash",
    "plan_revision",
    "state",
    "runtime_exec_id",
    "result_ref",
    "created_at",
    "updated_at"
  ],
  "event_keys": ["schema_version", "task_id", "run_id", "sequence", "event_id", "type", "occurred_at", "payload"],
  "message_keys": ["id", "task_id", "role", "parts", "references", "offset", "created_at", "delivered_at"],
  "error_keys": ["code", "message", "details", "retryable"]
}
