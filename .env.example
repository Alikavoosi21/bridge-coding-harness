# Optional developer configuration. This file contains no credentials.
# Bridge does not automatically load .env files; export needed values in your shell.
# Normal desktop launches need none of these values.

# Empty uses the OS default: %APPDATA%/BridgeCodingHarness on Windows.
HARNESS_HOME=
HARNESS_PORT=8765

# Desktop generates a fresh local engine token at each launch.
# For standalone API development use: python -m server --dev
# Do not commit a real token here or expose the development API to the network.
HARNESS_TOKEN=

# Enter provider API keys inside Bridge Settings > Models.
# Keys are stored in Windows Credential Manager, not in this repository or .env.
